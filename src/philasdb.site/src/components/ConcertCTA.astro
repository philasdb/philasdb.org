---
import { Picture } from "astro:assets";
import flyerImage from "../images/concert-2026-flyer.webp";
---

<section id="concert-cta">
  <div class="concert-banner">
    <div class="concert-image">
      <Picture
        src={flyerImage}
        widths={[212, 300, 424]}
        sizes="(max-width: 424px) 100vw, 424px"
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        alt="Annual Fundraising Concert flyer, September 26, 2026 at 4PM, Philadelphia 7th Day Baptist Church"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="concert-content">
      <p>
        <strong>Join us for our Annual Fundraising Concert!</strong>
        Saturday, September 26, 2026 at 4:00 PM &mdash; an afternoon of praise, worship,
        and inspiration. Please RSVP by September 5th.
      </p>
      <a href="/concert/2026" class="concert-button">Learn More &amp; RSVP</a>
    </div>
  </div>
</section>

<style>
  #concert-cta {
    padding: 0;
    margin: 0;
  }

  .concert-banner {
    max-width: 424px;
    margin: 0 auto;
    overflow: hidden;
  }

  .concert-image :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .concert-content {
    padding: 1rem 1.5rem;
    text-align: center;
  }

  .concert-content p {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .concert-button {
    display: inline-block;
    background: #6c2eb7;
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.3s;
  }

  .concert-button:hover {
    background: #5a2596;
  }
</style>

