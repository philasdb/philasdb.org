---
import MainLayout from "../../../layouts/MainLayout.astro";
---

<MainLayout title="Annual Fundraising Concert 2026" canonical="/concert/2026">
  <section style="max-width: 700px; margin: 2rem auto; background: #f7f2ff; border-radius: 1.5rem; box-shadow: 0 4px 24px rgba(80,0,80,0.08); overflow: hidden;">
    <div style="padding: 2rem;">
      <h1 style="color: #6c2eb7; font-size: 2.2rem; margin-bottom: 0.5rem; font-family: 'Montserrat', sans-serif; font-weight: 700;">Annual Fundraising Concert</h1>
      <p style="font-size: 1.1rem; color: #222; margin-bottom: 1.5rem;">Join us for an afternoon of praise, worship, and inspiration at Philadelphia 7th Day Baptist Church!</p>
      <div style="margin-bottom: 1.5rem;">
        <div style="margin-bottom: 0.75rem;"><strong>Date:</strong> <span style="color: #6c2eb7;">September 26, 2026</span></div>
        <div style="margin-bottom: 0.75rem;"><strong>Time:</strong> <span style="color: #6c2eb7;">4:00 PM</span></div>
        <div style="margin-bottom: 0.75rem;"><strong>Location:</strong> 6841 Ardleigh Street, Philadelphia, PA 19119</div>
      </div>
      <div style="background: #f8f9fa; border-radius: 0.75rem; padding: 1rem; margin-bottom: 1.5rem; border-left: 3px solid #6c2eb7;">
        <div style="margin-bottom: 0.5rem;"><strong>Tickets:</strong> $20 for adults, $10 for children 15 and under</div>
        <div style="color: #666; font-size: 0.9rem;">Refreshments available for purchase</div>
      </div>
      <div style="background: #f0f8ff; border-radius: 1rem; padding: 1.5rem; border: 2px solid #e6f3ff; text-align: center;">
        <h2 style="color: #6c2eb7; font-size: 1.3rem; margin-bottom: 0.75rem;">RSVP by September 5th</h2>
        <p style="margin-bottom: 1rem;">Please let us know you're coming, and feel free to share this invitation with friends and family!</p>
        <a href="mailto:philasdb@gmail.com?subject=Annual%20Fundraising%20Concert%20RSVP"
           style="display: inline-block; background: #6c2eb7; color: white; padding: 0.75rem 1.5rem; border-radius: 0.5rem; text-decoration: none; font-weight: 600; transition: background-color 0.3s;"
           onmouseover="this.style.backgroundColor='#5a2596'"
           onmouseout="this.style.backgroundColor='#6c2eb7'">
          RSVP via Email
        </a>
      </div>
    </div>
  </section>
</MainLayout>
