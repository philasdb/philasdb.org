---
import MainLayout from "../layouts/MainLayout.astro";

const registryUrl =
    "https://www.amazon.com/registries/gl/guest-view/KXFF62GWNUEW";
---

<MainLayout
    title="Tyler Gahagan's Book Wish List"
    canonical="tyler-gahagan"
    description="Support Philadelphia Seventh Day Baptist Church member Tyler Gahagan as he begins pastoral ministry classes. View his book wish list."
>
    <nav aria-label="breadcrumb">
        <ul>
            <li><a href="/">Home</a></li>
            <li>Tyler's Book Wish List</li>
        </ul>
    </nav>

    <div class="wish-list">
        <section class="wish-list-card" aria-labelledby="page-title">
            <div class="book-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none">
                    <path
                        d="M24 14.5c-4.4-3.1-10.2-3.7-16-1.8v22c5.8-1.9 11.6-1.3 16 1.8m0-22c4.4-3.1 10.2-3.7 16-1.8v22c-5.8-1.9-11.6-1.3-16 1.8m0-22v22"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    />
                </svg>
            </div>

            <p class="intro">
                Tyler Gahagan, a member of our church, has begun pastoral
                ministry classes. These books will support his studies and
                preparation for ministry.
            </p>
            <p>
                If you'd like to encourage Tyler along the way, you can browse
                his book wish list on Amazon. Every gift is completely
                optional, and your support is appreciated.
            </p>

            <a
                class="registry-link"
                href={registryUrl}
                target="_blank"
                rel="noopener noreferrer"
            >
                View Tyler's book wish list on Amazon
                <span aria-hidden="true">↗</span>
            </a>

            <p class="link-note">
                The list opens on Amazon. You can choose whether or not to
                purchase anything.
            </p>
        </section>
    </div>
</MainLayout>

<style>
    .wish-list {
        padding: 2rem 1rem 4rem;
    }

    .wish-list-card {
        box-sizing: border-box;
        max-width: 680px;
        margin: 0 auto;
        padding: clamp(2rem, 7vw, 4rem);
        border: 1px solid #e5e9ed;
        border-radius: 1.25rem;
        background: linear-gradient(145deg, #fff 55%, #f4f7f8);
        box-shadow: 0 16px 48px rgb(28 48 68 / 8%);
        text-align: center;
    }

    .book-mark {
        display: grid;
        width: 4rem;
        height: 4rem;
        margin: 0 auto 1.5rem;
        place-items: center;
        border-radius: 50%;
        background: #edf3f4;
        color: #315f63;
    }

    .book-mark svg {
        width: 2rem;
        height: 2rem;
    }

    .intro {
        color: #344b5a;
        font-size: 1.15rem;
        line-height: 1.7;
    }

    .wish-list-card > p:not(.link-note) {
        max-width: 520px;
        margin-right: auto;
        margin-left: auto;
        line-height: 1.75;
    }

    .registry-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        margin-top: 1rem;
        padding: 0.9rem 1.35rem;
        border-radius: 0.5rem;
        background: #315f63;
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 150ms ease;
    }

    .registry-link:hover {
        background: #254a4e;
        color: #fff;
    }

    .registry-link:focus-visible {
        outline: 3px solid #b27a32;
        outline-offset: 3px;
    }

    .link-note {
        margin: 1rem 0 0;
        color: #586771;
        font-size: 0.9rem;
    }
</style>
